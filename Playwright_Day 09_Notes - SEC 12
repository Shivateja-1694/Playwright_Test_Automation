import { expect, test, request } from "@playwright/test";
import { APIUtils } from "./utils/APIUtils";


const loginPayload = {
    userEmail: "anshika@gmail.com",
    userPassword: "Iamking@000"
};


const orderPayload = {
    orders: [{
        country: "India",
        productOrderedId: "6960eae1c941646b7a8b3ed3"
    }]
};


const fakePayloadOrder = {
    data: [],
    message: "No Orders"
};


let apiResponse: any;


test.beforeAll(async () => {

    // Create API request context
    const apiContext = await request.newContext();

    // Create APIUtils object
    const apiUtils = new APIUtils(
        apiContext,
        loginPayload
    );

    // Login through API and create order
    apiResponse = await apiUtils.createOrder(
        orderPayload
    );

});


test("Placing Order", async ({ page }) => {

    // Set token in browser localStorage
    await page.addInitScript(value => {

        window.localStorage.setItem(
            "token",
            value
        );

    }, apiResponse.token);


    // Open application
    await page.goto(
        "https://rahulshettyacademy.com/client"
    );


    // Intercept Get Orders API
    await page.route(
        "https://rahulshettyacademy.com/api/ecom/order/get-orders-for-customer/*",
        async route => {

            // Send original request to server
            const response =
                await page.request.fetch(
                    route.request()
                );


            // Create fake response body
            const body =
                JSON.stringify(fakePayloadOrder);


            // Send fake response to browser
            await route.fulfill({
                response,
                body
            });

        }
    );


    // Go to My Orders
    await page
        .locator("button[routerlink*='myorders']")
        .click();


    // Wait for Get Orders API response
    await page.waitForResponse(
        "https://rahulshettyacademy.com/api/ecom/order/get-orders-for-customer/*"
    );


    // Print message displayed in UI
    console.log(
        await page.locator(".mt-4").textContent()
    );

}


