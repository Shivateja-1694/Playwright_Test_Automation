RECOMMENDED CONFIGURATION
------------------------

For the current Playwright project:

import { defineConfig } from '@playwright/test';

export default defineConfig({

    // Location of test files
    testDir: './tests',

    // Maximum time allowed for each test
    timeout: 40 * 1000,

    // Maximum time to wait for assertions
    expect: {
        timeout: 40 * 1000,
    },

    // Test report
    reporter: 'html',

    // Browser and other test settings
    use: {
        browserName: 'chromium',
    },

});

