ASSIGNMENT — ADD PRODUCT TO CART AND VERIFY PRODUCT IN CART
--------------------------------

OBJECTIVE
--------------------------------

This test demonstrates how to:

→ Login to an e-commerce website.
→ Find a specific product.
→ Click "Add To Cart" for that product.
→ Locate the Cart button.
→ Open the Cart.
→ Wait for the Cart page/content to load.
→ Verify that the selected product is visible in the Cart.
→ Use an assertion to validate the result.


--------------------------------
COMPLETE CODE
--------------------------------

import { test, expect } from '@playwright/test';

test.only('Automate e-Commerce website', async ({ page }) => {

    const userName = page.locator('#userEmail');
    const password = page.locator("#userPassword");
    const loginBtn = page.locator('#login');
    const products = page.locator('.card-body');
    const productName = 'ZARA COAT 3';
    const addToCartBtn = page.locator('[routerlink*="cart"]');

    await page.goto("https://rahulshettyacademy.com/client");

    await userName.fill('anshika@gmail.com');
    await password.fill('Iamking@000');
    await loginBtn.click();

    await page.waitForLoadState('networkidle');
    await page.locator('.card-body b').first().waitFor();

    const count = await products.count();

    for (let i = 0; i < count; ++i) {

        const product = products.nth(i);

        if (await product.locator('b').textContent() === productName) {
            await product.locator("text= Add To Cart").click();
            break;
        }
    }

    await addToCartBtn.click();

    await page.locator("div li").first().waitFor();

    expect(
        await page.locator("h3:has-text('ZARA COAT 3')").isVisible()
    ).toBeTruthy();

    await page.pause();

});


